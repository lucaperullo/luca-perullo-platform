# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# remotion render artifacts
/tmp/
/public/scroll-video/*.webp

# claude code local state (per-machine; not portable)
/.claude/

# voice clone pipeline — locale, non committare
.venv-voice/
scripts/.lesson-scripts.json
scripts/__pycache__/
# i sample audio della voce di Luca restano sulla macchina di Luca
voce-luca*.wav
voce-luca*.mp3
voce-luca*.m4a

# MP3 lezioni — generati localmente da scripts/tts-shortcut-batch.py.
# Sono ~50-100 MB totali (3 file per lezione × 81 lezioni). Meglio
# rigenerarli ogni volta o caricarli su CDN esterno (S3/R2) invece
# di gonfiare il git repo. Per il deploy su Vercel: o build hook
# che li rigenera, o link a CDN esterno.
public/play-audio/
