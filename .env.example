# ────────────────────────────────────────────────────────────────────
# .env.example — template per nuovi setup.
#
# Copia in `.env.local` e sostituisci i valori. .env.local NON va
# committato (è in .gitignore).
#
# Regola Next.js:
#   NEXT_PUBLIC_*  → esposte al browser (bundle client)
#   senza prefisso → solo server (API routes, server components)
# ────────────────────────────────────────────────────────────────────


# ── Stripe ────────────────────────────────────────────────────────
# Test in dev (sk_test_/pk_test_), live solo in produzione.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...


# ── Cal.com ───────────────────────────────────────────────────────
CAL_API_KEY=cal_live_...
NEXT_PUBLIC_CAL_USERNAME=lucaperullo


# ── Supabase (auth + play_progress) ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
# Service role: solo se serve per webhook/job server-side privilegiati.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...


# ── URL base ──────────────────────────────────────────────────────
# Usata per: magic link redirect (email auth), Stripe checkout return URL.
# DEVE essere il dominio canonico: https://lucaperullo.it in produzione,
# http://localhost:3000 in dev. NON lasciare localhost in .env.production
# o il magic link nelle email punterà a localhost (= morte del link
# quando l'utente apre la mail dal telefono).
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ── Admin gate ────────────────────────────────────────────────────────
# Email dell'unico utente che può accedere a /admin (fatturazione).
# Lower/uppercase non conta — confronto case-insensitive.
ADMIN_EMAIL=luca.perullo@icloud.com


# ── Fatture in Cloud ─────────────────────────────────────────────
# App OAuth creata su https://developers.fattureincloud.it/
FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
FIC_REDIRECT_URI=http://localhost:3000/api/admin/fic/oauth/callback
FIC_WEBHOOK_SECRET=
